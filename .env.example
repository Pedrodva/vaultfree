# Copy to .env to configure `docker compose up -d`

# --- Solo (default): only this machine can connect. Nothing to set. ---

# --- Team server with your own domain (automatic HTTPS) ---
# 1) point the domain's DNS A record to this machine, open ports 80 and 443
# 2) set the domain and run:  docker compose --profile https up -d
# VAULTFREE_DOMAIN=notes.example.com

# --- LAN only (no HTTPS): listen on all interfaces ---
# VAULTFREE_BIND=0.0.0.0

# --- Optional: permanent public address through a named Cloudflare tunnel ---
# Create the tunnel in the Cloudflare dashboard, then set its token and the hostname you mapped:
# VAULTFREE_TUNNEL_TOKEN=eyJ...
# VAULTFREE_DOMAIN=notes.example.com

VAULTFREE_PORT=3000
# Allow anyone to self-register (otherwise use invite links or the admin panel)
VAULTFREE_ALLOW_SIGNUP=false
VAULTFREE_USERS_CAN_CREATE_VAULTS=true
