{
  "name": "vaultfree",
  "version": "0.1.0",
  "description": "VaultFree — open-source, self-hosted, multi-user knowledge base with an Obsidian-style graph view and first-class AI integration (REST + MCP).",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/OWNER/vaultfree.git" },
